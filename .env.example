ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=10

# Canvas (POST /v1/materials/from-canvas): URL sin barra final
CANVAS_BASE_URL=https://eigcampus.instructure.com
CANVAS_ACCESS_TOKEN=

# Storage (Paso 1): backend = local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/objects
S3_BUCKET=prisma-calificacion-canvas
AWS_REGION=us-east-2

# Credenciales Canvas (Paso 2): backend = env | secrets_manager
# - env: usa CANVAS_BASE_URL/CANVAS_ACCESS_TOKEN (single-tenant, dev/migración)
# - secrets_manager: un secreto por universidad+env: {secret_prefix}/{env}/canvas/{universidad}
CREDENTIALS_BACKEND=env
CANVAS_SECRET_PREFIX=prisma/grading

# Cola (Paso 6): backend = memory | sqs
QUEUE_BACKEND=memory
SQS_QUEUE_URL=
QUEUE_WAIT_SECONDS=20
QUEUE_MAX_MESSAGES=5
